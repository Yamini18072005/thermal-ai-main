# ===================================================
# THERMAL EQUITY AI - BACKEND ENVIRONMENT CONFIGURATION
# ===================================================

# MongoDB Atlas connection string (backend only)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority&appName=thermal-equity
DATABASE_NAME=thermal_equity

# Security & JWT Configuration (Generate a cryptographically random secret)
SECRET_KEY=your_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Authentication and dashboard data require MongoDB.
REQUIRE_MONGODB=true

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Host & Port
PORT=8000
HOST=127.0.0.1